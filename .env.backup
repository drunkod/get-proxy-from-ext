# .env.example
# Jazz Server Account (generate with: npx jazz-run account create --name "Proxy Server")
JAZZ_PROXY_SERVER_ACCOUNT=
JAZZ_PROXY_SERVER_SECRET=

# Jazz Client Account (generate with: npx jazz-run account create --name "Proxy Client")
JAZZ_PROXY_CLIENT_ACCOUNT=
JAZZ_PROXY_CLIENT_SECRET=

# Jazz Sync Server
JAZZ_SYNC_URL=ws://node205197-env-9764176354321.mircloud.host:11129

# Webhook Server
PORT=3000
WEBHOOK_URL=http://localhost:3000/proxy-update